map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Empty keys for reads keep GET/HEAD traffic out of the write backstop.
map $request_method $write_limit_key {
    default "";
    POST    $binary_remote_addr;
    PUT     $binary_remote_addr;
    PATCH   $binary_remote_addr;
    DELETE  $binary_remote_addr;
}

# Trust forwarded client IPs only from exact load-balancer CIDRs listed here.
real_ip_header X-Forwarded-For;
real_ip_recursive on;
include /etc/nginx/trusted-proxies.conf;

# NGINX shared-memory zones are shared by every worker in this ingress.
limit_req_status 429;
limit_req_zone $binary_remote_addr zone=auth_session:10m rate=600r/m;
limit_req_zone $binary_remote_addr zone=auth_logout:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=auth_all:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=auth_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=auth_register:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=auth_email_requests:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=auth_token_actions:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=csp_report:10m rate=120r/m;
limit_req_zone $write_limit_key zone=write_api:10m rate=120r/m;

# Docker's embedded resolver keeps upstream addresses fresh after service recreation.
resolver 127.0.0.11 ipv6=off valid=10s;
resolver_timeout 5s;

upstream web_upstream {
    zone web_upstream 64k;
    server ${WEB_UPSTREAM} resolve;
    keepalive 32;
}

upstream api_upstream {
    zone api_upstream 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 32;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 6m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location = /_ingress-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/auth-routes.conf;

    location = /api/v1/metrics {
        return 404;
    }

    location = /api/v1/csp-report {
        limit_req zone=csp_report burst=40 nodelay;
        proxy_pass http://api_upstream;
        include /etc/nginx/proxy-common.conf;
    }

    location = /api/v1/crm/realtime/stream {
        proxy_pass http://api_upstream;
        include /etc/nginx/proxy-common.conf;
        proxy_buffering off;
    }

    location ~* ^/api/v1/(conversations|reports|reviews|services|orders|media)(/|$) {
        limit_req zone=write_api burst=60 nodelay;
        limit_req_status 429;
        error_page 429 = @write_rate_limited;
        proxy_pass http://api_upstream;
        include /etc/nginx/proxy-common.conf;
    }

    location @write_rate_limited {
        internal;
        default_type application/json;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
        return 429 '{"code":"RATE_LIMITED","message":"Muitos pedidos. Aguarda antes de tentar novamente."}';
    }

    location / {
        proxy_pass http://web_upstream;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        include /etc/nginx/proxy-common.conf;
    }
}

# Development exposes this listener for direct API tools, but it still passes
# through the same IP limits. Production does not publish this port.
server {
    listen 4000;
    server_name _;
    server_tokens off;
    client_max_body_size 6m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    include /etc/nginx/auth-routes.conf;

    location = /api/v1/metrics {
        return 404;
    }

    location = /api/v1/csp-report {
        limit_req zone=csp_report burst=40 nodelay;
        proxy_pass http://api_upstream;
        include /etc/nginx/proxy-common.conf;
    }

    location ~* ^/api/v1/(conversations|reports|reviews|services|orders|media)(/|$) {
        limit_req zone=write_api burst=60 nodelay;
        limit_req_status 429;
        error_page 429 = @write_rate_limited;
        proxy_pass http://api_upstream;
        include /etc/nginx/proxy-common.conf;
    }

    location @write_rate_limited {
        internal;
        default_type application/json;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
        return 429 '{"code":"RATE_LIMITED","message":"Muitos pedidos. Aguarda antes de tentar novamente."}';
    }

    location / {
        proxy_pass http://api_upstream;
        include /etc/nginx/proxy-common.conf;
    }
}
