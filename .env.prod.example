POSTGRES_DB=praca_angola
POSTGRES_USER=praca
POSTGRES_PASSWORD=generate_a_long_random_secret
DATABASE_URL=postgresql://praca:generate_a_long_random_secret@postgres:5432/praca_angola
REDIS_URL=redis://redis:6379
PUBLIC_DOMAIN=marketplace.example
ACME_EMAIL=admin@marketplace.example
WEB_ORIGIN=https://marketplace.example
PUBLIC_SITE_URL=https://marketplace.example
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-provider-secret
SMTP_FROM=PUVO <no-reply@marketplace.example>
APP_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Só durante a rotação; remover depois de `--verify` passar.
# APP_ENCRYPTION_KEY_PREVIOUS=chave-antiga-com-pelo-menos-32-caracteres
METRICS_TOKEN=replace-with-a-long-random-token
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
META_APP_SECRET=replace-with-meta-app-secret
AI_INTERNAL_SECRET=replace-with-a-long-random-internal-secret
# Lista de hosts HTTPS aprovados para IA personalizada; vazio desativa destinos personalizados.
CUSTOM_AI_ALLOWED_HOSTS=
SENTRY_DSN=
MEDIA_QUOTA_BYTES_PER_USER=52428800
MEDIA_QUOTA_ASSETS_PER_USER=100
RATE_LIMIT_ENABLED=true
